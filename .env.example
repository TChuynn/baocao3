PORT=3000
JWT_SECRET=change-me-to-a-secure-secret
JWT_EXPIRES_IN=7d
DB_PATH=./data/event_management.db
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cấu hình gửi Email SMTP (Để gửi email thực tế qua Gmail hoặc máy chủ SMTP)
# Đối với Gmail: dùng email Gmail và Mật khẩu ứng dụng 16 ký tự (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI EventHub" <no-reply@aieventhub.com>
